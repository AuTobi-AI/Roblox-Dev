{
  "name": "RobloxDev",
  "servePort": 34872,
  "emitLegacyScripts": false,
  "globIgnorePaths": ["**/*.spec.luau"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Color": [0.235294, 0.235294, 0.27451],
          "Material": "Slate",
          "Position": [0, -0.5, 0],
          "Size": [256, 1, 256]
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Duration": 0,
          "Neutral": true,
          "Position": [0, 1, 0],
          "Size": [12, 1, 12]
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Brightness": 2,
        "ClockTime": 14,
        "GlobalShadows": true,
        "Technology": "Future"
      }
    }
  }
}

